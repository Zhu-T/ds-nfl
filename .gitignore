# Environment variables (Sensitive IDs and Cookies)
.env
.env.local

# SQLite Databases & multi-session registry (per-user league data)
*.db
*.sqlite
*.sqlite3
/data/

# Python cache & virtual environment
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/

# Node / TypeScript
node_modules/
dist/
*.tsbuildinfo
.next/

# Playwright & Browser cache
.playwright/
test-results/
playwright-report/
# Persistent browser profile — holds live ESPN session cookies.
espn_openclaw_profile/
browser-profile/

# Recorded API fixtures are committed, but never raw traffic captures:
# those are what leaked a live Disney JWT. See docs/espn-protocol.md.
**/__fixtures__/raw/

# Log files
*.log
