{
  "name": "@ds-nfl/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop shell for ds-nfl.",
  "author": "ds-nfl",
  "main": "main.js",
  "scripts": {
    "stage": "node stage.mjs",
    "start": "npm run stage && electron .",
    "dist": "npm run stage && electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.dsnfl.app",
    "productName": "ds-nfl",
    "electronVersion": "33.4.11",
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "includeSubNodeModules": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": ["main.js", "package.json"],
    "extraResources": [
      {
        "from": "resources/server",
        "to": "server"
      }
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  }
}
